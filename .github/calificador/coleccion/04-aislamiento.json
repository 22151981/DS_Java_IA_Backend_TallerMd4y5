{
  "name": "4. Aislamiento entre salones y roles",
  "item": [
    {
      "name": "Registrar el salón B (otro cliente del SaaS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"tokenB\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salonNombre\": \"Salón Aurora {{sufijo}}\",\n  \"ciudad\": \"Bogotá\",\n  \"direccion\": \"Carrera 15 # 85-40\",\n  \"telefono\": \"601 555 9876\",\n  \"nombre\": \"Diana Torres\",\n  \"email\": \"diana.{{sufijo}}@aurora.co\",\n  \"password\": \"aurora1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "El salón B no ve la cita del salón A → 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{citaSaraId}}/estado",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{citaSaraId}}",
            "estado"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"CANCELADA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "El salón B no ve los servicios del salón A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista vacía\", () => pm.expect(pm.response.json().length).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/servicios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "servicios"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "El salón B no ve la agenda del salón A",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lista vacía\", () => pm.expect(pm.response.json().length).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/citas?fecha={{fecha}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas"
          ],
          "query": [
            {
              "key": "fecha",
              "value": "{{fecha}}"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenB}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Un dueño no entra a la administración → 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/admin/salones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "salones"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        }
      }
    }
  ]
}