{
  "name": "1. Registro, login y configuración",
  "item": [
    {
      "name": "Registrar el salón A (dueño)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sufijo\", Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test(\"Devuelve un token y el rol DUENO\", () => { pm.expect(r.token).to.be.a(\"string\"); pm.expect(r.rol).to.eql(\"DUENO\"); });",
              "pm.collectionVariables.set(\"tokenA\", r.token);",
              "pm.collectionVariables.set(\"slugA\", r.salonSlug);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salonNombre\": \"Barbería La Navaja {{sufijo}}\",\n  \"ciudad\": \"Medellín\",\n  \"direccion\": \"Calle 10 # 43-20\",\n  \"telefono\": \"604 555 1234\",\n  \"nombre\": \"Camilo Ríos\",\n  \"email\": \"camilo.{{sufijo}}@navaja.co\",\n  \"password\": \"secreta123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Registro con un correo que ya existe → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salonNombre\": \"Otra\",\n  \"ciudad\": \"Cali\",\n  \"direccion\": \"Cra 1\",\n  \"telefono\": \"3000000000\",\n  \"nombre\": \"Otro\",\n  \"email\": \"camilo.{{sufijo}}@navaja.co\",\n  \"password\": \"secreta123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Registro con datos inválidos → 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"El mensaje nombra los campos que fallaron\", () => { const m = pm.response.json().mensaje; pm.expect(m).to.include(\"email\"); pm.expect(m).to.include(\"password\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"salonNombre\": \"\",\n  \"ciudad\": \"Cali\",\n  \"direccion\": \"Cra 1\",\n  \"telefono\": \"3000000000\",\n  \"nombre\": \"Otro\",\n  \"email\": \"no-es-correo\",\n  \"password\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
