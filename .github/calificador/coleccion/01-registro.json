    {
      "name": "Mi salón sin token → 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/salon",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salon"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Mi salón (plan GRATIS y 10 créditos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Nace en plan GRATIS con créditos de cortesía\", () => { pm.expect(r.plan).to.eql(\"GRATIS\"); pm.expect(r.creditosIa).to.eql(10); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/salon",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salon"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Configurar el horario del salón",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Guarda el intervalo\", () => pm.expect(pm.response.json().configuracion.intervaloMinutos).to.eql(30));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/salon/configuracion",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salon",
            "configuracion"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"horaApertura\": \"08:00\",\n  \"horaCierre\": \"19:00\",\n  \"abreDomingos\": false,\n  \"intervaloMinutos\": 30\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
