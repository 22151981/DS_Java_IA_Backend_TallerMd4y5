      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve token\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));"
            ]
