{
  "name": "3. Agenda: reservas, cruces y estados",
  "item": [
    {
      "name": "Catálogo público del salón (sin token)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Calcula una fecha de lunes a sábado, al menos 2 días en el futuro, y el próximo domingo",
              "const d = new Date(); d.setDate(d.getDate() + 2);",
              "if (d.getDay() === 0) { d.setDate(d.getDate() + 1); }",
              "const iso = (x) => x.getFullYear() + \"-\" + String(x.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(x.getDate()).padStart(2, \"0\");",
              "pm.collectionVariables.set(\"fecha\", iso(d));",
              "const dom = new Date(); dom.setDate(dom.getDate() + ((7 - dom.getDay()) % 7 || 7));",
              "pm.collectionVariables.set(\"domingo\", iso(dom));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Muestra 2 servicios y 2 estilistas\", () => { pm.expect(r.servicios.length).to.eql(2); pm.expect(r.estilistas.length).to.eql(2); });",
              "pm.test(\"No expone correos del equipo\", () => pm.expect(pm.response.text()).to.not.include(\"@\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/publico/salones/{{slugA}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "publico",
            "salones",
            "{{slugA}}"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
