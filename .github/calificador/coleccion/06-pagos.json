    {
      "name": "Webhook firmado: pagó el plan PRO",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cuerpo = JSON.stringify({ id: \"evt_pro_\" + pm.collectionVariables.get(\"sufijo\"), object: \"event\", api_version: \"2026-09-30.endive\", type: \"checkout.session.completed\",",
              "  data: { object: { id: \"cs_test_\" + pm.collectionVariables.get(\"sufijo\"), object: \"checkout.session\", mode: \"subscription\", payment_status: \"paid\",",
              "    subscription: \"sub_\" + pm.collectionVariables.get(\"sufijo\"),",
              "    metadata: { salonId: String(pm.collectionVariables.get(\"salonIdA\")), tipo: \"SUSCRIPCION_PRO\" } } } });",
              "const t = Math.floor(Date.now() / 1000);",
              "const secreto = pm.variables.replaceIn(\"{{secretoWebhook}}\");",
              "const firma = CryptoJS.HmacSHA256(t + \".\" + cuerpo, secreto).toString(CryptoJS.enc.Hex);",
              "pm.collectionVariables.set(\"cuerpoWebhook\", cuerpo);",
              "pm.collectionVariables.set(\"firmaWebhook\", \"t=\" + t + \",v1=\" + firma);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Lo procesó\", () => pm.expect(pm.response.json().procesado).to.eql(true));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Stripe-Signature",
            "value": "{{firmaWebhook}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pagos/webhook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pagos",
            "webhook"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{{cuerpoWebhook}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
