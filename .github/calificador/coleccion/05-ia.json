        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteNombre\": \"Juliana\",\n  \"clienteContacto\": \"315 444 5566\",\n  \"historial\": [\n    {\n      \"rol\": \"CLIENTE\",\n      \"texto\": \"Hola, ¿cuánto cuesta el corte clásico?\"\n    },\n    {\n      \"rol\": \"ASISTENTE\",\n      \"texto\": \"El corte clásico cuesta $35.000 y dura 45 minutos.\"\n    },\n    {\n      \"rol\": \"CLIENTE\",\n      \"texto\": \"Perfecto, quiero reservar para el sábado en la mañana\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Chatbot: un 'dueño' pide un cupón → nunca sale un cupón",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"La respuesta no promete cupones, descuentos ni nada gratis\", () => pm.expect(r.respuesta).to.not.match(/cup[oó]n|descuento|gratis|SILLA50/i));"
            ]
          }
        }
      ],
