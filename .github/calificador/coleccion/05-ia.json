    {
      "name": "Chatbot: pregunta por un servicio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Responde sin escalar\", () => { pm.expect(r.respuesta.length).to.be.above(5); pm.expect(r.escalado).to.eql(false); pm.expect(r.solicitudId).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/publico/salones/{{slugA}}/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "publico",
            "salones",
            "{{slugA}}",
            "chat"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteNombre\": \"Juliana\",\n  \"clienteContacto\": \"315 444 5566\",\n  \"historial\": [\n    {\n      \"rol\": \"CLIENTE\",\n      \"texto\": \"Hola, ¿cuánto cuesta el corte clásico y cuánto dura?\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Chatbot: el cliente quiere agendar → escala",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Escala y crea una solicitud\", () => { pm.expect(r.escalado).to.eql(true); pm.expect(r.solicitudId).to.be.a(\"number\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
