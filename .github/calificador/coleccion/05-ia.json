{
  "name": "5. IA: recordatorio y chatbot",
  "item": [
    {
      "name": "Recordatorio con IA para la cita de Sara",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Trae el mensaje y el teléfono del cliente\", () => { pm.expect(r.mensaje.length).to.be.above(20); pm.expect(r.telefonoCliente).to.eql(\"3102223344\"); });",
              "pm.test(\"El mensaje menciona a Sara y la hora\", () => { pm.expect(r.mensaje).to.include(\"Sara\"); pm.expect(r.mensaje).to.include(\"10:30\"); });",
              "pm.test(\"Trae la factura de la IA\", () => { pm.expect(r.factura.proveedor).to.be.a(\"string\"); pm.expect(r.factura.tokensEntrada).to.be.above(0); });",
              "pm.test(\"Descontó un crédito\", () => pm.expect(r.creditosRestantes).to.eql(9));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/citas/{{citaSaraId}}/recordatorio",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "citas",
            "{{citaSaraId}}",
            "recordatorio"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenA}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Recordatorio de una cita COMPLETADA → 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
